{
  "extensions": {
    "disable": ["agent-browser", "keep-warm", "imagegen"]
  },
  "modelFamilies": {
    "families": {
      "lead": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "color": "orange"
      },
      "review": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "fast": {
        "model": "openai-codex/gpt-6.1-sol"
      }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      {
        "command": "mise exec node@26.5.0 -- pnpm check",
        "timeout": 300
      }
    ]
  }
}
