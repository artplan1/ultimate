{
  "extensions": {
    "disable": ["agent-browser", "keep-warm", "imagegen", "claude-code", "mcp"]
  },
  "modelFamilies": {
    "families": {
      "lead": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "color": "orange"
      },
      "review": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high"
      },
      "fast": {
        "model": "openai-codex/gpt-6.1-sol"
      }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": [
        "if [ \"$ULTIMATE_SOURCE\" = \"/Users/artem/projects/ultimate-fff\" ]; then test -d \"$ULTIMATE_SOURCE/node_modules\" && { test -e node_modules || ln -s \"$ULTIMATE_SOURCE/node_modules\" node_modules; }; else pnpm install --frozen-lockfile --prefer-offline; fi"
      ]
    }
  },
  "lander": {
    "checks": [
      {
        "command": "mise exec node@26.5.0 -- pnpm check",
        "timeout": 300
      }
    ]
  }
}
